# Copy to `.env` in the project root. Use one KEY=value per line.
# For Docker: `docker compose up --build` — DATABASE_URL/REDIS_URL are set in compose for the `api` service.

APP_NAME=teamcenter-analytics
APP_ENV=development
# Default matches Docker Compose service `db`. Override if Postgres runs elsewhere.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/teamcenter_analytics
REDIS_URL=
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
TEAMCENTER_MOCK_MODE=false
# Live Teamcenter (same origin as AWC) — e.g. http://tcappccmdev:3000
TEAMCENTER_BASE_URL=http://tcappccmdev:3000
TEAMCENTER_USER=
TEAMCENTER_PASSWORD=
TEAMCENTER_WARMUP_PATH=/tc/RestServices
TEAMCENTER_LOGIN_PATH=/tc/RestServices/Core-2011-06-Session/login
TEAMCENTER_CLIENT_ID=ActiveWorkspaceClient
TEAMCENTER_CLIENT_VERSION=10000.1.2
TEAMCENTER_CLIENT_DISCRIMINATOR=AWC13152
TEAMCENTER_LOCALE=en_US
# Optional: comma-separated GET paths after login (same session cookie jar)
TEAMCENTER_EXTRA_GET_PATHS=
# Comma-separated browser origins; leave empty for CORS * (JWT uses Authorization header, not cookies).
CORS_ORIGINS=
# Frontend: empty = relative /api (use VITE_PROXY_API_TARGET in dev, or a reverse proxy in prod).
VITE_API_URL=
# Docker `web` service: Vite proxies /api to the API container (set in docker-compose by default).
VITE_PROXY_API_TARGET=http://api:8000
